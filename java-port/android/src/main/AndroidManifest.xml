<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No network, no storage, no location.  VIBRATE is the one thing the
         game does ask for: Phase 3's haptics call Vibrator.vibrate, and without
         the permission that call fails on a real device.  Android lint caught
         it the moment an SDK made this module part of the build. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Haptics are a nicety, not a requirement: a device with no vibrator
         still installs and runs, and PlatformServices reports it unavailable. -->
    <uses-feature
        android:name="android.hardware.vibrate"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:isGame="true"
        android:theme="@style/GdxTheme"
        android:appCategory="game">

        <activity
            android:name=".android.AndroidLauncher"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
